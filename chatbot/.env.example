# Copy to .env and fill in. .env is ignored by git; never commit the key.

# Required: Gemini API key from https://aistudio.google.com/apikey (use a PAID-tier project:
# the free tier lets Google use what visitors type to improve its products).
GEMINI_API_KEY=

# Model for answers and for the safety classifier.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite

# Backup provider: used automatically when Gemini fails (no credit, outage, errors).
# Key from https://platform.deepseek.com/api_keys. Model: deepseek-flash (deepseek-v4-flash also works).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Sites allowed to call the API (comma-separated, exact origins).
ALLOWED_ORIGINS=https://capraecapital.com,https://www.capraecapital.com,https://dev-caprae.saasquatchleads.com

# Optional: Cloudflare Turnstile secret (bot check on the first message). Leave empty to disable.
TURNSTILE_SECRET=

# Limits
MAX_MESSAGE_CHARS=600
MAX_TURNS_PER_CHAT=12
PER_IP_PER_MINUTE=8
PER_IP_PER_DAY=60
DAILY_REQUEST_LIMIT=2000

# Daily cost alert (chatbot/cost-alert/cost-alert.js): emails once a day when AI spend passes the limit.
# It never stops the chatbot. Leave SMTP empty until ready; the script then just reports the cost.
DAILY_COST_LIMIT_USD=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
